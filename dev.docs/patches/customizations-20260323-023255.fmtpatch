+   agentsPanel: "overview" | "files" | "tools" | "skills" | "channels" | "cron";
+   agentsModelKeyError: string | null;
++  agentsModelKeyModalError: string | null;
+   agentFilesLoading: boolean;
+   agentFilesError: string | null;
+   agentFilesList: AgentsFilesListResult | null;
+diff --git a/ui/src/ui/app.ts b/ui/src/ui/app.ts
+index b96c043da..6e1afa523 100644
+--- a/ui/src/ui/app.ts
++++ b/ui/src/ui/app.ts
+@@ -214,6 +214,7 @@ export class OpenClawApp extends LitElement {
+   @state() agentsPanel: "overview" | "files" | "tools" | "skills" | "channels" | "cron" =
+     "overview";
+   @state() agentsModelKeyError: string | null = null;
++  @state() agentsModelKeyModalError: string | null = null;
+   @state() agentFilesLoading = false;
+   @state() agentFilesError: string | null = null;
+   @state() agentFilesList: AgentsFilesListResult | null = null;
