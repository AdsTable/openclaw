++    "</head><body>",
++    "<div class=\"sidebar\"><h2>&#129422; OpenClaw History</h2><div class=\"s-list\" id=\"list\"></div></div>",
++    "<div class=\"chat\">",
++    "<div class=\"chat-top\" id=\"top\">&#8592; &#1042;&#1099;&#1073;&#1077;&#1088;&#1080;&#1090;&#1077; &#1089;&#1077;&#1089;&#1089;&#1080;&#1102;</div>",
