++++Subject: [PATCH 11/18] refactor(modal): split into
++++ agentsModelKeyModalError(modal) + agentsModelKeyError(callout)
++++
++++---
++++ CUSTOMIZATIONS.md             | 12 ++++++++----
++++ ui/src/ui/app-render.ts       |  2 ++
++++ ui/src/ui/app-settings.ts     |  4 ++--
++++ ui/src/ui/app-view-state.ts   |  1 +
++++ ui/src/ui/app.ts              |  1 +
