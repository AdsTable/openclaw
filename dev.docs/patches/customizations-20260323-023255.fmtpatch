++++Write-Host "Format-patch saved: $fmtPatch ($((Get-Item $fmtPatch).Length) bytes)" -ForegroundColor Green
++++
++++# diff patch: human-readable for review
++++$diffPatch = "$patchDir/customizations-$date.diff"
