+++++-      if (!entry || typeof entry !== "object") {
+++++-        continue;
+++++-      }
+++++-      addModelConfigIds(out, (entry as Record<string, unknown>).model);
+++++-    }
+++++-  }
+++++-  return [...out].toSorted((a, b) => a.localeCompare(b));
+++++-}
