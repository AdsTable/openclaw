+++++-  ".js",
+++++-  ".css",
+++++-  ".json",
+++++-  ".map",
+++++-  ".svg",
+++++-  ".png",
+++++-  ".jpg",
+++++-  ".jpeg",
+++++-  ".gif",
+++++-  ".webp",
+++++-  ".ico",
+++++-  ".txt",
