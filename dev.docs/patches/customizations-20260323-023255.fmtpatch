+++@@ -168,86 +136,125 @@ export function handleControlUiAvatarRequest(
+++ 
+++   const resolved = opts.resolveAvatar(agentId);
+++   if (resolved.kind !== "local") {
+++-    respondControlUiNotFound(res);
++++    respondNotFound(res);
+++     return true;
+++   }
+++ 
+++-  const safeAvatar = resolveSafeAvatarFile(resolved.filePath);
+++-  if (!safeAvatar) {
+++-    respondControlUiNotFound(res);
++++  if (req.method === "HEAD") {
++++    res.statusCode = 200;
++++    res.setHeader("Content-Type", contentTypeForExt(path.extname(resolved.filePath).toLowerCase()));
++++    res.setHeader("Cache-Control", "no-cache");
++++    res.end();
+++     return true;
+++   }
