++++  if (req.method === "HEAD") {
++++    res.statusCode = 200;
++++    res.setHeader("Content-Type", contentTypeForExt(path.extname(resolved.filePath).toLowerCase()));
++++    res.setHeader("Cache-Control", "no-cache");
++++    res.end();
+++     return true;
+++   }
