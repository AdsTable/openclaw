+ export async function loadOverview(host: SettingsHost) {
+-  const app = host as unknown as OpenClawApp;
+-  await Promise.allSettled([
+-    loadChannels(app, false),
+-    loadPresence(app),
+-    loadSessions(app),
+-    loadCronStatus(app),
+-    loadCronJobs(app),
+-    loadDebug(app),
+-    loadSkills(app),
+-    loadUsage(app),
+-    loadOverviewLogs(app),
++  await Promise.all([
