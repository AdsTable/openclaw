From 826a6270ec74def921e5933d9d0f68adbeed0a68 Mon Sep 17 00:00:00 2001
From: AdsTable <50158033+AdsTable@users.noreply.github.com>
Date: Mon, 16 Mar 2026 06:14:02 +0100
Subject: [PATCH 14/26] =?UTF-8?q?fix(build):=20add=20plugin=20runtime=20en?=
 =?UTF-8?q?try=20to=20tsdown=20=E2=80=94=20fixes=20'Unable=20to=20resolve?=
 =?UTF-8?q?=20plugin=20runtime=20module'=20in=20dist?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

---
 tsdown.config.ts | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/tsdown.config.ts b/tsdown.config.ts
index 80eaae39a4..950a1d8087 100644
--- a/tsdown.config.ts
+++ b/tsdown.config.ts
@@ -156,6 +156,11 @@ export default defineConfig([
   nodeBuildConfig({
     entry: "src/extensionAPI.ts",
   }),
+  nodeBuildConfig({
+    // Plugin runtime must live at dist/runtime/index.js so the plugin loader
+    // (resolvePluginRuntimeModulePath) can find it when running from dist/.
+    entry: { "runtime/index": "src/plugins/runtime/index.ts" },
+  }),
   nodeBuildConfig({
     entry: ["src/hooks/bundled/*/handler.ts", "src/hooks/llm-slug-generator.ts"],
   }),
-- 
