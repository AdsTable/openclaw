+     const isActive = option.value === current;
+     return html`<option value=${option.value} style=${isActive ? "font-weight:bold" : ""}
+-      >${isActive ? `◀ ${option.label} (current)` : option.label}</option
++      >${isActive ? `${option.label} <- current` : option.label}</option
+     >`;
+   });
+ }
+-- 
+2.51.1.windows.1
