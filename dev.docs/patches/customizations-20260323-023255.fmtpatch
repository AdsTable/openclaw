+++-+  display: flex;
+++-+  align-items: center;
+++-+  justify-content: center;
+++-+  padding: 24px;
+++-+  z-index: 201;
+++-+}
+++-+
+++-+.api-key-modal-card {
+++-+  width: min(480px, 100%);
+++-+  background: var(--card);
+++-+  border: 1px solid var(--danger, #e53e3e);
+++-+  border-radius: var(--radius-lg);
+++-+  padding: 20px;
+++-+  animation: scale-in 0.2s var(--ease-out);
+++-+}
+++-+
+++-+.api-key-modal-header {
+++-+  display: flex;
+++-+  align-items: center;
