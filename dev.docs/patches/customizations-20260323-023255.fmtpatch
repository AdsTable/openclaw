+                   state.agentsModelKeyError = null;
++                  state.agentsModelKeyModalError = null;
+                   loadConfig(state);
+                 },
+                 onConfigSave: async () => {
+@@ -517,6 +518,7 @@ export function renderApp(state: AppViewState) {
+                     return;
+                   }
