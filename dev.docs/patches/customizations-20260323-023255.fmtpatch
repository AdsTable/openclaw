++++++ b/dev.docs/patches/customizations-20260303-0258.fmtpatch
+++@@ -0,0 +1,14774 @@
++++From 2505155fe8d29107c29c813c4cfff49ec3f28618 Mon Sep 17 00:00:00 2001
++++From: AdsTable <50158033+AdsTable@users.noreply.github.com>
++++Date: Sat, 28 Feb 2026 03:57:21 +0100
++++Subject: [PATCH 01/18] feat: add session history viewer at /history, History
++++ button in Sessions UI, ignore .vs/
++++
++++---
++++ .gitignore                  |  1 +
++++ src/gateway/control-ui.ts   | 90 +++++++++++++++++++++++++++++++++++++
++++ ui/src/ui/views/sessions.ts | 16 +++++--
++++ 3 files changed, 103 insertions(+), 4 deletions(-)
++++
++++diff --git a/.gitignore b/.gitignore
++++index 118e70583..7e90fe2c2 100644
++++--- a/.gitignore
+++++++ b/.gitignore
++++@@ -92,3 +92,4 @@ package-lock.json
