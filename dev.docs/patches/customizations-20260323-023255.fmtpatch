+++   res.setHeader("Content-Type", "text/plain; charset=utf-8");
+++@@ -229,6 +314,11 @@ export function handleControlUiHttpRequest(
+++ 
+++   applyControlUiSecurityHeaders(res);
+++ 
++++  // Session history viewer — served dynamically from .jsonl files
