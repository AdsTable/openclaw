+++-      res.setHeader("Content-Type", contentTypeForExt(path.extname(safeAvatar.path).toLowerCase()));
+++-      res.setHeader("Cache-Control", "no-cache");
+++-      res.end();
+++-      return true;
+++-    }
+++ 
