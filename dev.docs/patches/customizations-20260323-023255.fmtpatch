++   // If current model is not in configured list, prepend it as-is
++@@ -386,8 +387,12 @@ export function buildModelOptions(
++     : options;
++   return sorted.map((option) => {
++     const isActive = option.value === current;
+++    const provider = option.value.split("/")[0];
