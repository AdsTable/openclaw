+++++-function addModelConfigIds(target: Set<string>, modelConfig: unknown) {
+++++-  if (!modelConfig) {
+++++-    return;
+++++-  }
+++++-  if (typeof modelConfig === "string") {
+++++-    addModelId(target, modelConfig);
