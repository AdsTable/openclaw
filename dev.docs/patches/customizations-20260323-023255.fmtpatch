++++ ui/src/ui/app.ts                     |   1 +
++++ ui/src/ui/views/agents-utils.ts      |  26 ++++--
++++ ui/src/ui/views/agents.ts            |   5 ++
++++ 8 files changed, 145 insertions(+), 54 deletions(-)
++++
++++diff --git a/src/gateway/server-methods-list.ts b/src/gateway/server-methods-list.ts
++++index 1bff6bf88..03fb116fd 100644
++++--- a/src/gateway/server-methods-list.ts
+++++++ b/src/gateway/server-methods-list.ts
++++@@ -34,6 +34,7 @@ const BASE_METHODS = [
++++   "talk.mode",
++++   "models.list",
