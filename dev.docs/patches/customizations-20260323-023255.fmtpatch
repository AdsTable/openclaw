+++          <button
+++            class="btn btn--sm primary"
+++            ?disabled=${configSaving || !configDirty}
+++            @click=${onConfigSave}
+++          >
+++            ${configSaving ? "Saving…" : "Save"}
+++          </button>
+++        </div>
+++      </div>
+++    </section>
+++  `;
+++}
