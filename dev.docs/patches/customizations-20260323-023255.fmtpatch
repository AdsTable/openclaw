+++++function handleSessionHistoryRoute(
+++++  req: IncomingMessage,
+++++  res: ServerResponse,
+++++  pathname: string,
+++++  basePath: string,
+++++): boolean {
+++++  const historyPath = basePath ? `${basePath}/history` : "/history";
