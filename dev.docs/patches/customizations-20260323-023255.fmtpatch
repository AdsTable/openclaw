+++++-    if (opened.reason === "io") {
+++++-      throw opened.error;
+++++-    }
+++++-    return null;
+++++-  }
+++++-  return { path: opened.path, fd: opened.fd };
++++++  res.end(fs.readFileSync(indexPath, "utf8"));
