++++-+    "<div class=\"footer\" id=\"footer\" style=\"display:none\">&#1057;&#1086;&#1086;&#1073;&#1097;&#1077;&#1085;&#1080;&#1081;: <span id=\"fC\"></span> &nbsp; &#1052;&#1086;&#1076;&#1077;&#1083;&#1100;: <span id=\"fM\"></span></div>",
