From 129db3fe4f5043354aa51ec4ff1d72b9fc09738b Mon Sep 17 00:00:00 2001
From: AdsTable <50158033+AdsTable@users.noreply.github.com>
Date: Thu, 19 Mar 2026 12:56:12 +0100
Subject: [PATCH 23/26] fix(ui): add browser process polyfill before app
 bootstrap to prevent node-require process crash

---
 dev.docs/scripts/merge-upstream.ps1 |  2 ++
 ui/src/main.ts                      |  1 +
 ui/src/process-polyfill.ts          | 24 ++++++++++++++++++++++++
 3 files changed, 27 insertions(+)
 create mode 100644 ui/src/process-polyfill.ts

diff --git a/dev.docs/scripts/merge-upstream.ps1 b/dev.docs/scripts/merge-upstream.ps1
index 182ad9d3cc..022954bb0e 100644
--- a/dev.docs/scripts/merge-upstream.ps1
+++ b/dev.docs/scripts/merge-upstream.ps1
@@ -64,6 +64,8 @@ $CustomFiles = @(
   "ui/src/node-stubs/empty.ts",
   "ui/src/node-stubs/path.ts",
   "ui/src/node-stubs/os.ts",
+  "ui/src/process-polyfill.ts",
+  "ui/src/main.ts",
   # zh-CN templates translated to English (all 13 files)
   "docs/zh-CN/reference/templates/AGENTS.dev.md",
   "docs/zh-CN/reference/templates/AGENTS.md",
diff --git a/ui/src/main.ts b/ui/src/main.ts
index 9374bb20ec..7f67133f97 100644
--- a/ui/src/main.ts
+++ b/ui/src/main.ts
@@ -1,2 +1,3 @@
+import "./process-polyfill.ts";
 import "./styles.css";
 import "./ui/app.ts";
diff --git a/ui/src/process-polyfill.ts b/ui/src/process-polyfill.ts
new file mode 100644
index 0000000000..0f34960ecb
--- /dev/null
+++ b/ui/src/process-polyfill.ts
@@ -0,0 +1,24 @@
+// Browser runtime shim for server-oriented modules that reference `process`
+// at module top-level (e.g. src/logging/node-require.ts).
+
+type BrowserProcessShim = {
+  env: Record<string, string>;
+  cwd: () => string;
+  platform: string;
+  version: string;
+  versions: { node: string };
+  getBuiltinModule?: undefined;
+};
+
+const g = globalThis as typeof globalThis & { process?: BrowserProcessShim };
+
+if (typeof g.process === "undefined") {
+  g.process = {
+    env: {},
+    cwd: () => "/",
+    platform: "browser",
+    version: "v0.0.0",
+    versions: { node: "0.0.0" },
+    getBuiltinModule: undefined,
+  };
+}
-- 
2.51.1.windows.1


