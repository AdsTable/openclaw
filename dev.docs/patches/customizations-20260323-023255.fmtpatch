++++++    const suffix = isActive ? " ← current" : "";
++++++    return html`<option value=${option.value} style=${isActive ? "font-weight:bold" : ""}
++++++      >${`${prefix}${option.label}${suffix}`}</option
++++++    >`;
++++++  });
+++++ }
