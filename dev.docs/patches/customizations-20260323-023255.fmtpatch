+++++ scripts/merge-upstream.ps1                    |   27 +-
+++++ src/gateway/server-methods/agents.ts          |    4 +-
+++++ ui/src/ui/app-render.ts                       |    2 +-
+++++ ui/src/ui/components/modal.ts                 |    4 +-
+++++ 6 files changed, 3199 insertions(+), 13 deletions(-)
+++++ create mode 100644 .githooks/pre-push
