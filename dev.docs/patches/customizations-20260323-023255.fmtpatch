+++++-
+++++-  .cron-checkbox-inline {
+++++-    padding-top: 0;
+++++-  }
+++++-
+++++-  .cron-stagger-group {
+++++-    grid-template-columns: 1fr;
+++++-    gap: 12px;
+++++-  }
+++++-
+++++-  .cron-filter-search {
+++++-    min-width: 0;
+++++-    flex: 1 1 100%;
+++++-  }
+++++-
+++++-  .cron-run-filters__row--primary,
+++++-  .cron-run-filters__row--secondary {
+++++-    grid-template-columns: 1fr;
+++++-  }
+++++-
+++++-  .cron-filter-dropdown__panel {
+++++-    width: 100%;
+++++-    max-width: none;
+++++-    position: static;
+++++-    margin-top: 8px;
+++++-  }
+++++-
+++++-  .cron-run-entry__meta {
+++++-    min-width: 0;
+++++-    text-align: left;
+++++-  }
+++++-}
