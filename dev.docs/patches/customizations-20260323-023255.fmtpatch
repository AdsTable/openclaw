++-+function fmt(s){let h=esc(s);h=h.replace(/\`\`\`[\\w]*\\n([\\s\\S]*?)\`\`\`/g,function(_,c){return'<pre><code>'+c.trimEnd()+'</code></pre>';});h=h.replace(/\`([^\`\\n]+)\`/g,'<code>$1</code>');h=h.replace(/\\*\\*([^*\\n]+)\\*\\*/g,'<strong>$1</strong>');return h;}
