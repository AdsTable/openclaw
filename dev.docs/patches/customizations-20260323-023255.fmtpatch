+++   | { kind: "none"; reason: string }
+++   | { kind: "local"; filePath: string }
+++@@ -131,7 +99,7 @@ export function handleControlUiAvatarRequest(
+++   if (!urlRaw) {
+++     return false;
+++   }
+++-  if (!isReadHttpMethod(req.method)) {
++++  if (req.method !== "GET" && req.method !== "HEAD") {
+++     return false;
+++   }
+++ 
+++@@ -150,7 +118,7 @@ export function handleControlUiAvatarRequest(
