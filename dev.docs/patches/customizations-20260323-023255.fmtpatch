+++++-function isExpectedSafePathError(error: unknown): boolean {
+++++-  const code =
+++++-    typeof error === "object" && error !== null && "code" in error ? String(error.code) : "";
+++++-  return code === "ENOENT" || code === "ENOTDIR" || code === "ELOOP";
+++++-}
