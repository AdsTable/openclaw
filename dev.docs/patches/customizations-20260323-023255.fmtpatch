+-         <div class="row" style="justify-content: flex-end; gap: 8px;">
+-           <button class="btn btn--sm" ?disabled=${configLoading} @click=${onConfigReload}>
+-             Reload Config
+-diff --git a/ui/src/ui/views/sessions.ts b/ui/src/ui/views/sessions.ts
